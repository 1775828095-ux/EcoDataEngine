      "source_depth_cm": [
        0,
        10
      ],
      "soil_moisture_basis": "volumetric"
    }
  },
  "source": {
    "kind": "real_reanalysis",
    "description": "NOAA NCEP-NCAR reanalysis 4xDaily topsoil0-10cm; 2024-01-01 00/06UTC; exact2 adjacent Gaussian latitude rows and3 longitudes, no interpolation",
