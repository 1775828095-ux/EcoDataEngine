{
  "rules": [
    {"id":"source_grid_mismatch","problem_type":"source_grid_alignment","when":{"source_grid_mismatch":true},"required":["continuous_spatial_resampling"],"because":"This declared source grid differs from the requested fusion grid; its own data port must be regridded before fusion"},
    {"id":"required_coarse_observation","problem_type":"coarse_observation_consistency","when":{"require_coarse_consistency":true},"required":["coarse_scale_consistency"],"hard":["declared_observation_operator"],"because":"Explicit consistency requirement must be implemented on the actual output path"},
    {"id":"optional_coarse_observation","problem_type":"coarse_observation_consistency","when":{"coarse_observations_available":true,"require_coarse_consistency":false},"optional":["coarse_scale_consistency"],"because":"Legal original coarse observations permit a consistency trial, not a promised accuracy gain"},
    {"id":"training_bias_diagnosis","problem_type":"training_bias","when":{"training_bias_supported":true},"optional":["bias_correction"],"because":"A legal training pair supports a training-period bias diagnosis only"},
    {"id":"visible_temporal_missing","problem_type":"missing_observations","when":{"missing_input":true,"temporal_recovery":true},"required":["temporal_missing_recovery"],"because":"Actual missing input values require recovery; natural missing values are not reference truth"},
    {"id":"category_composition_task","when":{"output_representation":"category_fractions"},"required":["fractional_categorical_aggregation"],"hard":["declared_category_composition"],"because":"Composition fractions are not integer category-code predictions"},
    {"id":"spatial_statistics_task","when":{"scientific_operation":"spatial_statistics"},"required":["continuous_spatial_aggregation"],"hard":["declared_spatial_statistic"],"because":"A regional minimum or maximum is a different output statistic, not ordinary field resampling"},
    {"id":"extreme_correction_task","when":{"scientific_operation":"extreme_value_correction"},"required":["extreme_value_correction"],"hard":["training_application_separation"],"because":"Tail correction has a distinct data and fitting contract"},
    {"id":"soil_depth_task","when":{"scientific_operation":"soil_profile"},"required":["soil_profile_processing"],"hard":["declared_depth_units"],"because":"Soil depth conversion is not 2D image resampling"},
    {"id":"vertical_task","when":{"scientific_operation":"vertical_interpolation"},"required":["vertical_interpolation"],"hard":["vertical_coordinate_contract"],"because":"Use actual declared vertical-coordinate contracts"},
    {"id":"curvilinear_task","when":{"scientific_operation":"curvilinear_regridding"},"required":["curvilinear_regridding"],"hard":["coordinate_contract"],"because":"Two-dimensional source coordinates require a swath/curvilinear backend"},
    {"id":"terrain_pressure_task","when":{"scientific_operation":"terrain_pressure_adjustment"},"required":["terrain_pressure_adjustment"],"hard":["terrain_inputs"],"because":"Explicit terrain pressure task; not all meteorological variables"},
    {"id":"terrain_weather_task","when":{"scientific_operation":"terrain_downscaling"},"required":["terrain_aware_weather_downscaling"],"hard":["terrain_inputs"],"because":"Existing weather downscaler must actually consume terrain"},
    {"id":"bias_task","when":{"scientific_operation":"bias_correction"},"required":["bias_correction"],"hard":["training_application_separation"],"because":"Bias correction needs real disjoint training pairs"},
    {"id":"feature_encoding_task","when":{"scientific_operation":"feature_encoding"},"required":["pretrained_feature_encoding"],"hard":["feature_not_prediction"],"because":"Encoding is not environmental-variable fusion"},
    {"id":"feature_stack_task","when":{"scientific_operation":"feature_stack"},"required":["multiscale_feature_preparation"],"hard":["variable_semantics"],"because":"Feature preparation preserves heterogeneous variable meaning"},
    {"id":"explicit_spatial_processing", "when":{"spatial_processing":true,"variable_class":"continuous"}, "required":["continuous_spatial_resampling"], "hard":["coordinate_monotonicity"], "because":"Explicit continuous spatial grid task requires a real spatial operator"},
    {"id":"explicit_category_processing", "when":{"spatial_processing":true,"variable_class":"categorical"}, "required":["categorical_scale_processing"], "hard":["category_preservation"], "because":"Categorical output is not continuous interpolation"},
    {"id":"explicit_temporal_processing", "when":{"temporal_processing":true}, "required":["temporal_processing"], "hard":["interval_semantics"], "because":"Temporal processing must be backed by an executed temporal operator"},
    {"id":"covariate_prediction", "when":{"covariate_estimation":true}, "required":["external_drift_estimation","observation_interpolation"], "hard":["training_station_split","covariate_not_target","compatible_units"], "because":"Actual station and covariate ports must enter external-drift estimation; AOD is not PM2.5"},
    {"id":"temporal_recovery", "when":{"temporal_recovery":true}, "required":["temporal_missing_recovery"], "hard":["masked_target_isolation"], "because":"恢复只允许访问公开保留值和合法历史拟合状态"},
    {"id":"one_sided_recovery", "when":{"temporal_recovery":true,"require_complete_coverage":true,"one_sided_support":true}, "required":["boundary_temporal_recovery"], "hard":[], "because":"输入含单侧时间支持，输出路径需要相应恢复能力；不指定方法或赢家"},
    {"id":"complete_recovery", "when":{"temporal_recovery":true,"require_complete_coverage":true}, "required":["complete_temporal_coverage"], "hard":[], "because":"完整性落实到输出路径的实际时间支持，而不是全图能力并集"},
    {"id":"observation_support", "when":{"temporal_recovery":true,"prefer_observation_support":true}, "required":[], "soft":["retained_observation_support"], "because":"优先依赖当前保留观测的证据偏好，不预测恢复精度；历史估计仍合法"},
    {"id":"past_only_recovery", "when":{"temporal_recovery":true,"past_only":true}, "required":[], "hard":["past_only"], "because":"仅过去观测任务不允许读取未来保留值"},
    {"id":"mean_temporal", "when":{"temporal_semantics":"interval_mean","temporal_scale_change":true}, "required":["temporal_mean_resampling"], "hard":["interval_mean_semantics"], "because":"平均值改变时间尺度必须按区间定义处理，不能当累计量求和"},
    {"id": "category_coarsening", "when": {"variable_class": "categorical", "target_is_coarser": true}, "required": ["categorical_aggregation"], "hard": ["category_preservation"], "soft": ["category_fraction_consistency"], "because": "分类网格向粗尺度聚合需要众数或类别组成，最近邻抽样不能等同于聚合"},
    {"id": "station_grid", "when": {"station_to_grid": true}, "required": ["observation_interpolation"], "hard": ["training_station_split", "compatible_units"], "soft": ["coverage_and_extrapolation_risk"], "because": "站点到网格需要不规则观测空间估计能力"},
    {"id": "topographic_context", "when": {"topographic_auxiliary": true, "domain": "weather"}, "required": [], "hard": [], "soft": ["topography_assisted_downscaling"], "because": "已提供地形辅助信息；只有输入齐全且经验证的地形气象算法才可参与"},
    {"id": "continuous_spatial", "when": {"variable_class": "continuous", "spatial_scale_change": true}, "required": ["continuous_spatial_resampling"], "hard": ["coordinate_monotonicity"], "soft": ["coarse_scale_consistency"], "because": "连续变量发生空间尺度变化"},
    {"id": "categorical_spatial", "when": {"variable_class": "categorical", "spatial_scale_change": true}, "required": ["categorical_scale_processing"], "hard": ["category_preservation"], "soft": ["category_fraction_consistency"], "because": "分类变量不能使用连续数值插值"},
    {"id": "accumulation_temporal", "when": {"temporal_semantics": "accumulation", "temporal_scale_change": true}, "required": ["temporal_accumulation"], "hard": ["interval_conservation"], "soft": ["missing_interval_transparency"], "because": "累计量改变时间尺度时必须保持统计区间含义"},
    {"id": "nonnegative", "when": {"nonnegative": true}, "required": ["nonnegative_validation"], "hard": ["nonnegative_output"], "soft": [], "because": "已确认变量具有非负物理约束"},
    {"id": "multi_source", "when": {"multi_source": true}, "required": ["multi_source_fusion"], "hard": ["same_physical_variable", "compatible_units"], "soft": ["source_traceability"], "because": "存在多个来源"},
    {"id": "quality_aware", "when": {"multi_source": true, "quality_difference": true}, "required": ["quality_aware_fusion"], "hard": ["independent_validation_only"], "soft": ["validation_weighted_reliability"], "because": "同类多源数据质量存在可靠证据支持的差异"},
    {"id": "model_target", "when": {"target_model": true}, "required": ["model_compatibility_validation"], "hard": ["required_model_fields"], "soft": ["model_grid_preference"], "because": "目标模拟器具有输入契约"},
    {"id": "unknown_unit", "when": {"unit_known": false}, "required": [], "hard": [], "soft": [], "unknown": ["unit"], "because": "缺少可靠单位证据"},
    {"id": "unknown_support", "when": {"support_known": false}, "required": [], "hard": [], "soft": [], "unknown": ["pixel_support"], "because": "像元支持域/统计含义不明确"}
  ]
}
