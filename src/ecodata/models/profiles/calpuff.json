{
  "adapter_status": "index_only",
  "requirements_status": "official_document_indexed",
  "adapter_note": "模型需求已按官方资料建立索引；原生文件导出器尚未通过对应版本样例验收。",
  "id": "calpuff",
  "name": "CALPUFF",
  "category": "大气",
  "reference_version": "7.2.1",
  "official_sources": [
    "https://www.src.com/calpuff/calpuff1.htm",
    "https://www.epa.gov/scram/air-quality-dispersion-modeling-preferred-and-recommended-models"
  ],
  "input_formats": [
    "CALMET binary/text",
    "keyword text control files",
    "ASCII/space-delimited emissions and receptor files",
    "GeoTIFF terrain/land-use source data"
  ],
  "required_variables": [
    "control_parameters",
    "meteorology",
    "terrain",
    "land_use",
    "emissions",
    "receptors"
  ],
  "variable_aliases": {
    "meteorology": ["CALMET", "surface_meteorology", "upper_air_meteorology"],
    "terrain": ["DEM", "elevation", "terrain_height"],
    "land_use": ["landuse", "land_cover"],
    "emissions": ["sources", "point_sources", "area_sources", "line_sources", "volume_sources"],
    "receptors": ["receptor_grid", "discrete_receptors"]
  },
  "requirements": {
    "files": [
      "calpuff.inp",
      "CALMET.DAT",
      "GEO.DAT",
      "ptemarb.dat",
      "lnemarb.dat",
      "aremarb.dat",
      "voemarb.dat",
      "receptor files",
      "species/chemistry files"
    ],
    "dimensions": [
      "time",
      "x",
      "y",
      "z",
      "source",
      "receptor",
      "species"
    ],
    "time": "simulation-specific; meteorological, emission and receptor timing must be consistent",
    "special": "CALMET fields must cover the domain and simulation period; model options require matching source types, species and receptor grids"
  },
  "outputs": "hourly concentration/deposition grids, visibility and diagnostic output files",
  "exchange_notes": "CALMET produces the meteorological input; CALPOST post-processes CALPUFF outputs",
  "preparation_scenario": {
    "id": "calpuff_standardized_v1",
    "name": "CALPUFF 需求匹配与标准化预处理",
    "adapter": "standardized",
    "status": "standardized_preprocessing",
    "output_format": "NetCDF",
    "native_model_input": false,
    "format_scope": "standardized_only",
    "target_crs": "EPSG:4326",
    "record_only_roles": [],
    "derivable_fields": [],
    "native_gaps": [
      "未实现 CALPUFF/CALMET 原生控制、气象、GEO、排放和受体文件写出",
      "未使用对应版本官方工具读取或运行平台输出",
      "缺少无需许可证的官方完整 CALPUFF 原生测试项目"
    ],
    "inputs": [
      {
        "role": "control_parameters",
        "name": "控制参数",
        "required": true,
        "formats": ["JSON", "CSV", "Excel"],
        "dimensions": ["record"],
        "crs": "不适用",
        "time": "模拟起止时间",
        "space": "项目域说明",
        "fields": [
          {"name": "simulation_start", "standard_name": "simulation_start_time", "unit": "ISO8601", "data_type": "datetime", "aliases": ["start_date", "start"]},
          {"name": "simulation_end", "standard_name": "simulation_end_time", "unit": "ISO8601", "data_type": "datetime", "aliases": ["end_date", "end"]},
          {"name": "run_title", "standard_name": "run_title", "unit": "", "data_type": "string_identifier", "aliases": ["title", "project_name"], "required": false}
        ]
      },
      {
        "role": "meteorology",
        "name": "气象场",
        "required": true,
        "formats": ["NetCDF", "HDF5-NetCDF", "CSV"],
        "dimensions": ["time", "y", "x"],
        "crs": "EPSG:4326 或可靠投影网格",
        "time": "小时或更细，时间语义需明确",
        "space": "覆盖 CALPUFF/CALMET 模拟域",
        "fields": [
          {"name": "wind_speed", "standard_name": "wind_speed", "unit": "m/s", "data_type": "continuous", "aliases": ["wind", "ws"]},
          {"name": "wind_direction", "standard_name": "wind_from_direction", "unit": "degree", "data_type": "continuous", "aliases": ["wind_dir", "direction"], "required": false},
          {"name": "air_temperature", "standard_name": "air_temperature", "unit": "degC", "data_type": "continuous", "aliases": ["temperature", "t2m", "temp"]},
          {"name": "relative_humidity", "standard_name": "relative_humidity", "unit": "%", "data_type": "continuous", "aliases": ["humidity", "rh"]},
          {"name": "surface_pressure", "standard_name": "surface_air_pressure", "unit": "hPa", "data_type": "continuous", "aliases": ["pressure", "ps"], "required": false},
          {"name": "precipitation", "standard_name": "precipitation_amount", "unit": "mm", "data_type": "continuous", "aliases": ["precip", "prcp"], "required": false}
        ]
      },
      {
        "role": "terrain",
        "name": "地形",
        "required": true,
        "formats": ["GeoTIFF", "NetCDF", "HDF5-NetCDF"],
        "dimensions": ["y", "x"],
        "crs": "EPSG:4326 或可靠投影网格",
        "time": "静态",
        "space": "覆盖模拟域",
        "fields": [
          {"name": "elevation", "standard_name": "surface_altitude", "unit": "m", "data_type": "continuous", "aliases": ["dem", "height", "value"]}
        ]
      },
      {
        "role": "land_use",
        "name": "土地利用",
        "required": true,
        "formats": ["GeoTIFF", "NetCDF", "HDF5-NetCDF"],
        "dimensions": ["y", "x"],
        "crs": "EPSG:4326 或可靠投影网格",
        "time": "静态",
        "space": "覆盖模拟域",
        "fields": [
          {"name": "land_cover_class", "standard_name": "land_cover_class", "unit": "class_id", "data_type": "categorical", "aliases": ["land_cover", "landuse", "land_class"]}
        ]
      },
      {
        "role": "emissions",
        "name": "排放源",
        "required": true,
        "formats": ["CSV", "Excel", "JSON"],
        "dimensions": ["record"],
        "crs": "EPSG:4326",
        "time": "小时或配置周期",
        "space": "项目域内点/面源",
        "fields": [
          {"name": "source_id", "standard_name": "source_id", "unit": "", "data_type": "string_identifier", "aliases": ["id", "facility_id"]},
          {"name": "longitude", "standard_name": "longitude", "unit": "degree_east", "data_type": "continuous", "aliases": ["lon", "x"]},
          {"name": "latitude", "standard_name": "latitude", "unit": "degree_north", "data_type": "continuous", "aliases": ["lat", "y"]},
          {"name": "emission_rate", "standard_name": "emission_rate", "unit": "source-specific", "data_type": "continuous", "aliases": ["rate", "value"]},
          {"name": "species", "standard_name": "chemical_species", "unit": "", "data_type": "string_identifier", "aliases": ["pollutant"], "required": false}
        ]
      },
      {
        "role": "receptors",
        "name": "受体",
        "required": true,
        "formats": ["CSV", "GeoJSON"],
        "dimensions": ["record"],
        "crs": "EPSG:4326",
        "time": "静态",
        "space": "模拟域内离散受体",
        "fields": [
          {"name": "receptor_id", "standard_name": "receptor_id", "unit": "", "data_type": "string_identifier", "aliases": ["id", "station_id"], "required": false},
          {"name": "longitude", "standard_name": "longitude", "unit": "degree_east", "data_type": "continuous", "aliases": ["lon", "x"]},
          {"name": "latitude", "standard_name": "latitude", "unit": "degree_north", "data_type": "continuous", "aliases": ["lat", "y"]}
        ]
      }
    ]
  }
}
