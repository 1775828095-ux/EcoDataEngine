{
  "adapter_status": "standardized_preprocessing_supported",
  "requirements_status": "official_document_indexed",
  "adapter_note": "支持将已识别真实原始数据整理为可审查的 WASP 上游标准数据包；不生成或声称验证 WIF/INP。",
  "id": "wasp",
