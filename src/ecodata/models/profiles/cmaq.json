      "GRID_BDY_2D",
      "GRID_DOT_2D",
      "MET_BDY_3D",
      "emission streams"
    ],
    "dimensions": [
      "TSTEP",
      "LAY",
      "ROW",
      "COL",
      "PERIM",
      "VAR"
