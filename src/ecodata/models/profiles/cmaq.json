        "space": "覆盖目标网格",
        "fields": [
          {
            "name": "elevation",
            "aliases": [
              "value",
              "dem",
              "height"
            ],
            "unit": "m",
            "data_type": "continuous"
          }
        ]
      },
      {
        "role": "observation",
        "name": "观测约束数据",
        "required": true,
        "formats": [
          "CSV",
          "Excel",
          "Parquet"
        ],
        "dimensions": [
          "record"
        ],
        "crs": "明确CRS，点坐标可转EPSG:4326",
        "time": "与背景同窗口；不能把小时平均冒称瞬时值",
        "space": "有效站点在背景网格中心域内",
        "fields": [
          {
            "name": "PM25",
            "aliases": [
              "PM2.5",
              "value"
            ],
            "unit": "ug/m3",
            "data_type": "continuous"
          }
        ]
      },
      {
        "role": "boundary",
        "name": "边界条件",
        "required": false,
        "required_for_native": true,
        "formats": [
          "I/O API NetCDF"
        ],
        "dimensions": [
          "TSTEP",
          "LAY",
          "PERIM"
        ],
        "crs": "目标CMAQ网格一致",
        "time": "模拟边界时序",
        "space": "目标模型侧边界和垂直层",
        "fields": [
          {
            "name": "mechanism_species",
            "unit": "species-specific",
            "data_type": "continuous"
          }
        ],
        "processing": "本阶段只记录依赖，不生成或伪造边界场"
      }
    ],
    "native_gaps": [
      "对应版本/化学机制的三维物种初始场及垂直网格",
      "I/O API维度、TFLAG和投影/网格元数据",
      "WRF/MCIP完整气象与模型地形一致性",
      "真实边界条件和排放等运行依赖",
      "对应版本官方工具的原生读取验收",
