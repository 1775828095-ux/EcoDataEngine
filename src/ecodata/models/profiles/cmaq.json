          "bilinear",
          "nearest",
          "conservative"
        ]
      },
      {
        "name": "residual_method",
        "label": "站点残差插值",
        "key": "residual",
        "values": [
          "nearest",
          "linear"
        ]
      },
      {
        "name": "negative_policy",
        "label": "负浓度处理",
        "key": "negative",
        "values": [
