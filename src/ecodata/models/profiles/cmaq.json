            "unit": "degC",
            "data_type": "continuous"
          },
          {
            "name": "wind",
            "aliases": [
              "wind_speed"
            ],
            "unit": "m/s",
            "data_type": "continuous"
          },
          {
            "name": "humidity",
            "aliases": [
              "rh",
              "RH",
              "relative_humidity"
            ],
            "unit": "%",
            "data_type": "continuous"
          }
        ]
      },
      {
